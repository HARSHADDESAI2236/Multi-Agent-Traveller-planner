# Optional LLM provider. Leave blank to use the local deterministic planner.
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-1.5-flash

# Optional live-data integrations (leave blank to use sample data).
FLIGHT_API_KEY=your_flight_api_key_here
HOTEL_API_KEY=your_hotel_api_key_here
WEATHER_API_KEY=your_weather_api_key_here

LOG_LEVEL=INFO
